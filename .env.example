# =============================================================================
# GLOBAL ENVIRONMENT CONFIGURATION TEMPLATE - AI INCIDENT COMMANDER
# =============================================================================

# Database Configuration (MySQL)
DB_USERNAME=root
DB_PASSWORD=change_this_password
DB_HOST=localhost
DB_PORT=3307
MYSQL_ROOT_PASSWORD=change_this_password
MYSQL_DATABASE=incident_commander
MYSQL_PORT=3307

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# Service URLs
COMMAND_SERVICE_URL=http://localhost:8081
QUERY_SERVICE_URL=http://localhost:8082
AGENT_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084
PROMETHEUS_URL=http://localhost:9090

# AI Services API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Notification Mail Settings
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
ALERT_EMAIL=admin_alerts@example.com

# Docker Settings
DOCKER_HOST=tcp://localhost:2375
DOCKER_COMPOSE_DIR=C:/AI Incident Commander
